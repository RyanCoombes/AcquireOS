# Required: password for the internal database.
DB_PASSWORD=change-me-to-something-long

# Optional: require a login. Always set this if the app is reachable
# from outside your home network.
APP_USER=admin
APP_PASSWORD=

# Token for connecting Claude (MCP endpoint at /mcp) and for scripts using
# the REST API. Any long random string; or run: acquireos new-token
API_TOKEN=

# Port on the host. Open http://<pi-address>:8090
APP_PORT=8090

# Folders on the host.
DATA_DIR=/opt/acquireos/data
BACKUP_DIR=/opt/acquireos/backups
BACKUP_KEEP_DAYS=30
TZ=Europe/London

# Monthly Companies House refresh (day of month and hour).
REFRESH_DAY=6
REFRESH_HOUR=3
REFRESH_ACCOUNTS_MONTHS=1

# Image to run. Leave as is unless you build your own.
ACQUIREOS_IMAGE=ghcr.io/ryancoombes/acquireos:latest
